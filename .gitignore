# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Firebase CLI's local deploy cache (path, mtime, hash per file). Nothing reads
# it but the CLI, which rebuilds it on every `firebase deploy`, and CI never
# sees it — action-hosting-deploy uploads independently. Tracked, it just
# rewrote itself into the diff after each deploy.
.firebase/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?


# public/assets/ is the drop zone for working originals; only the compressed
# output is committed. This also stops stray Vite build output (index-*.js,
# hashed fonts) from being tracked if dist/ is ever copied in here again.
public/assets/*
!public/assets/compressed/

# Vite's entry point is the root index.html, and the build writes the real one
# into dist/ *after* copying public/ across. A public/index.html is therefore
# only ever stale build output: it shadows nothing, but it does send anyone
# editing the <head> to the wrong file. One was committed here once already.
public/index.html
