{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev-attach",
      "url": "http://localhost:5173",
      "port": 5173
    },
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview"
      ],
      "port": 4173
    },
    {
      "name": "hosting-emulator",
      "runtimeExecutable": "firebase",
      "runtimeArgs": [
        "emulators:start",
        "--only",
        "hosting",
        "--project",
        "portfolio-cf811"
      ],
      "port": 5000,
      "url": "http://127.0.0.1:5000"
    }
  ]
}
